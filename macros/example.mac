# =============================================================================
# TRD 模拟参数模板
# =============================================================================
# 使用方法：
#   ./build/trd macros/example.mac
#
# 规则：
#   1. 以 # 开头的行只是说明，不会执行。
#   2. 每个参数只保留一条没有 # 的设置；要换方案时，注释旧行并启用新行。
#   3. 数值和单位之间要留空格，例如 3 GeV、2.15 um、4 cm。
#   4. 本程序会自动 Initialize 和 BeamOn，不要添加 /run/initialize 或
#      /run/beamOn；事例数由 /trd/run/events 控制。
# =============================================================================


# -----------------------------------------------------------------------------
# 1. 入射粒子
# -----------------------------------------------------------------------------
# 可选粒子：
#   e-   电子
#   pi-  负 pion
#   mu-  负 muon
#
# 当前使用电子：
/trd/beam/particle e-
#
# 其他示例（一次只能启用一个）：
# /trd/beam/particle pi-
# /trd/beam/particle mu-


# -----------------------------------------------------------------------------
# 2. 入射动量
# -----------------------------------------------------------------------------
# 这是动量而不是动能，程序会根据粒子质量自动换算成动能。
# 常用单位：MeV、GeV。
# 同一动量下，不同粒子的 gamma 因子不同，TR 产额也会不同。
/trd/beam/momentum 3 GeV
#
# 可尝试：
# /trd/beam/momentum 500 MeV
# /trd/beam/momentum 1 GeV
# /trd/beam/momentum 5 GeV
# /trd/beam/momentum 10 GeV


# -----------------------------------------------------------------------------
# 3. 是否使用 TR 辐射体
# -----------------------------------------------------------------------------
# true：粒子先穿过辐射体，再进入气体探测器。
# false：移除辐射体，适合做“只有电离能损”的对照组。
/trd/radiator/enabled true
#
# 无辐射体对照：
# /trd/radiator/enabled false


# -----------------------------------------------------------------------------
# 4. 辐射体薄膜材料
# -----------------------------------------------------------------------------
# 使用 Geant4/NIST 材料名称，名称区分大小写。
/trd/radiator/material G4_MYLAR
#
# 可尝试的材料：
# /trd/radiator/material G4_POLYETHYLENE
# /trd/radiator/material G4_POLYPROPYLENE
# /trd/radiator/material G4_KAPTON
#
# 项目还专门实现了 Rohacell PMI 近似材料：
# /trd/radiator/material ROHACELL_HF71


# -----------------------------------------------------------------------------
# 5. 一个辐射周期的结构
# -----------------------------------------------------------------------------
# 一个周期 = 一层固体薄膜 + 一层空气间隙。
#
# foilThickness：单层薄膜厚度
# 常用扫描范围示例：2 um、5 um、10 um、20 um、50 um。
/trd/radiator/foilThickness 2.15 um
#
# 可尝试：
# /trd/radiator/foilThickness 5 um
# /trd/radiator/foilThickness 20 um

# gapThickness：相邻薄膜之间的空气间隙
# 常用扫描范围示例：30 um、80 um、200 um、500 um、1 mm。
/trd/radiator/gapThickness 80 um
#
# 可尝试：
# /trd/radiator/gapThickness 200 um
# /trd/radiator/gapThickness 500 um
# /trd/radiator/gapThickness 1 mm


# -----------------------------------------------------------------------------
# 6. 辐射体总长度
# -----------------------------------------------------------------------------
# 程序计算：
#   周期数 = floor(totalLength / (foilThickness + gapThickness))
# 因此只建立完整周期，终端打印的实际长度可能略小于这里设置的目标长度。
/trd/radiator/totalLength 4 cm
#
# 可尝试做长度扫描：
# /trd/radiator/totalLength 1 cm
# /trd/radiator/totalLength 2 cm
# /trd/radiator/totalLength 6 cm
# /trd/radiator/totalLength 10 cm


# -----------------------------------------------------------------------------
# 7. 气体探测器材料
# -----------------------------------------------------------------------------
# 本程序当前只接受下面三种名称：
#
#   XeNeIsobutane  Xe/Ne/异丁烷混合气
#   XeCO2_85_15    Xe/CO2 = 85/15（摩尔/体积分数）
#   XeCO2_95_5     Xe/CO2 = 95/5（摩尔/体积分数）
#
/trd/detector/gas XeNeIsobutane
#
# 其他选择（一次只能启用一个）：
# /trd/detector/gas XeCO2_85_15
# /trd/detector/gas XeCO2_95_5


# -----------------------------------------------------------------------------
# 8. 模拟事例数
# -----------------------------------------------------------------------------
# 一个 event 对应一个入射粒子。
# 建议先用 1～10 个检查参数和输出，再逐步增加。
# TR 模型计算较慢；50000 个事例可能需要较长时间。
/trd/run/events 10
#
# 正式计算示例：
# /trd/run/events 1000
# /trd/run/events 10000
# /trd/run/events 50000


# -----------------------------------------------------------------------------
# 9. ROOT 输出目录
# -----------------------------------------------------------------------------
# 这是目录，不是 ROOT 文件名。程序会根据粒子自动生成：
#   e-  -> trd_electron.root
#   pi- -> trd_pion.root
#   mu- -> trd_muon.root
#
# 相对路径以运行 ./build/trd 时所在的目录为起点，而不是以 .mac 所在目录为起点。
/trd/output/directory output/tutorial
#
# 做参数扫描时，建议每组参数使用不同目录，防止 RECREATE 覆盖旧文件：
# /trd/output/directory output/electron_3GeV_mylar_2um_gap80um
# /trd/output/directory output/no_radiator_electron_3GeV


# =============================================================================
# 常见修改组合
# =============================================================================
#
# A. 只研究普通电离能损：
#      /trd/radiator/enabled false
#
# B. 比较不同粒子：
#      分别运行 e-、pi-、mu-，并为每次运行设置不同输出目录。
#
# C. 扫描入射动量：
#      依次修改 /trd/beam/momentum 为 1、3、5、10 GeV。
#
# D. 扫描辐射体：
#      修改 foilThickness 和 gapThickness，但保持 totalLength 不变。
#
# E. 做有/无 TR 辐射体对照：
#      其他参数保持不变，只修改 enabled，并使用两个不同输出目录。

# Auto-generated Xe/CO2 85:15 detector-gas scan
# 5 GeV/c e-, PE/air=25/100 um
# requested radiator=8 cm, periods=640, actual=8 cm
/trd/beam/particle e-
/trd/beam/momentum 5 GeV
/trd/radiator/material G4_POLYETHYLENE
/trd/radiator/foilThickness 25 um
/trd/radiator/gapThickness 100 um
/trd/radiator/totalLength 8 cm
/trd/detector/gas XeCO2_85_15
/trd/output/directory /home/wljxs/projects/TR/geant4simulation/xe_co2_85_15_length_scan/root/radiator_8cm
/run/initialize
/run/beamOn 50000
